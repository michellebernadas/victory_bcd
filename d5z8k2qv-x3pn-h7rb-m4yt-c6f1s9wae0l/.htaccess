# Deltek Cares Admin Panel Security Configuration

# Prevent access to sensitive files

<FilesMatch "\.(env|sql|log|bak|backup|conf|config|ini)$">
Require all denied
</FilesMatch>

# Protect sensitive directories - Admin has more directories to protect

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(vendor|config|models|controllers|utils)/ - [F,L]
    
    # Force HTTPS for admin panel (uncomment when SSL certificate is installed)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Enhanced security headers for admin panel

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.datatables.net https://code.jquery.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.datatables.net https://code.jquery.com; img-src 'self' data: https: http:; font-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; frame-src 'self' https://education.deltek.com"
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# Prevent access to hidden files

<FilesMatch "^\.">
Require all denied
</FilesMatch>

# Prevent access to backup files

<FilesMatch "\~$">
Require all denied
</FilesMatch>

# Prevent directory browsing

Options -Indexes

# Set proper MIME types

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
</IfModule>

# PHP upload settings override (ensure 5MB uploads work)

php_value upload_max_filesize 5M
php_value post_max_size 6M
php_value max_execution_time 60
php_value memory_limit 256M

# Additional admin security - prevent access to view files directly

<IfModule mod_rewrite.c>
    RewriteRule ^views/ - [F,L]
</IfModule>

# Rate limiting for admin login attempts (if mod_evasive is available)

<IfModule mod_evasive24.c>
    DOSHashTableSize    2048
    DOSPageCount        10
    DOSPageInterval     1
    DOSSiteCount        50
    DOSSiteInterval     1
    DOSBlockingPeriod   600
</IfModule>
