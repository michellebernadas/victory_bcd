# Copy this file to `.env` and fill in the four values.
#
# `.env` is deliberately NOT in git — it holds the database password. That
# means a fresh deploy (git clone / git pull) arrives WITHOUT it, and the app
# cannot start until you create it. A missing .env is the single most likely
# cause of a blank HTTP 500 on a newly deployed server: config/config.php
# throws before any page renders.
#
# After creating .env, also confirm:
#   * `vendor/` exists on the server   -> run: composer install --no-dev
#   * `logs/` is writable by the web user (IIS: IUSR / IIS_IUSRS; Apache: www-data)
#
# Never commit the real .env.

DB_HOST=localhost
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Optional. Defaults to Asia/Manila; only set this if the church moves.
# APP_TIMEZONE=Asia/Manila
