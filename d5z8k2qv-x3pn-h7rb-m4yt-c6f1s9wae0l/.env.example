# Copy this file to `.env` and fill in the four values.
#
# `.env` is deliberately NOT in git — it holds the database password. That
# means a fresh deploy (git clone / git pull) arrives WITHOUT it, and the app
# cannot start until you create it. A missing .env is the single most likely
# cause of a blank HTTP 500 on a newly deployed server: config/config.php
# throws before any page renders.
#
# After creating .env, also confirm:
#   * `vendor/` exists on the server   -> run: composer install --no-dev
#   * `logs/` is writable by the web user (IIS: IUSR / IIS_IUSRS; Apache: www-data)
#
# Never commit the real .env.

DB_HOST=localhost
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Optional. Defaults to Asia/Manila; only set this if the church moves.
# APP_TIMEZONE=Asia/Manila

# ── Email (optional but recommended) ─────────────────────────────────────────
# When someone says they are interested in a Victory Group, the group's leader
# is emailed (the "Email to notify" address on the group) and staff get a copy.
# Leave MAIL_HOST empty to send nothing: messages are saved to logs/mail.log and
# the Interested People inbox shows that the leader was NOT emailed.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls          # tls (STARTTLS, port 587) | ssl (port 465) | none
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@yourchurch.org
# MAIL_FROM_NAME="Victory Bacolod"
# JOIN_NOTIFY_EMAIL=office@yourchurch.org      # staff copy of every request (comma separated)
